# Shared non-secret configuration only. Copy to local env files; never commit real secrets.
ROOT_DOMAIN=example.invalid
ENVIRONMENT=development

# Where the registration code comes from: development (printed to the log, never a real
# message) | whatsapp (the official WhatsApp Cloud API) | whatsapp_bot (the paired account in
# services/whatsapp-bot). Production refuses to start when the chosen one is unconfigured.
OTP_PROVIDER=development

# OTP_PROVIDER=whatsapp — from the Meta app, plus the approved Authentication template.
# The id and the token are secrets: set them in the environment, never here.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# OTP_PROVIDER=whatsapp_bot — the bot service on the private network, and the shared secret it
# is started with (services/whatsapp-bot/README.md). The token is a secret.
WHATSAPP_BOT_URL=http://127.0.0.1:8085
WHATSAPP_BOT_TOKEN=
