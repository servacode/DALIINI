DJANGO_SETTINGS_MODULE=directory_backend.settings.development
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://directory:directory@localhost:5432/directory
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_SIGNING_KEY=CHANGE_ME_LOCAL_ONLY
REFRESH_HMAC_SECRET=CHANGE_ME_LOCAL_ONLY
RECOVERY_HMAC_SECRET=CHANGE_ME_LOCAL_ONLY
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME_LOCAL_ONLY
S3_SECRET_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
S3_PUBLIC_BUCKET=directory-public
S3_PRIVATE_BUCKET=directory-private
# development (delivers nothing, for local work and tests) or whatsapp.
OTP_PROVIDER=development

# WhatsApp, through Meta's Cloud API. A business may only open a conversation with a template
# Meta approved beforehand, so the code travels inside an "Authentication" template. Required
# in production when OTP_PROVIDER=whatsapp; the token is a secret and belongs in the
# environment, never in a file that is committed.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar
PUSH_PROVIDER=development
PUSH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_LOCAL_ONLY
FCM_PROJECT_ID=
# With PUSH_PROVIDER=fcm: the Firebase service account key JSON, or that JSON in base64.
FCM_SERVICE_ACCOUNT_JSON=
ANALYTICS_HASH_SALT=CHANGE_ME_LOCAL_ONLY
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional. Shared secret the website's server sends as X-Daliini-Web-Key, so its anonymous
# public reads are limited under THROTTLE_WEB_SERVER (default 3000/minute) instead of per IP.
# Grants no data or permission. Leave empty to disable. Set the same value on the web app.
WEB_SERVER_API_KEY=
THROTTLE_WEB_SERVER=3000/minute
# Optional. Number of trusted reverse proxies; set it (e.g. 1) so throttles read the client
# address from X-Forwarded-For. Unset, the contact form throttle uses REMOTE_ADDR only.
DRF_NUM_PROXIES=
THROTTLE_CONTACT=3/hour
