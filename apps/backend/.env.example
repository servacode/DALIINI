DJANGO_SETTINGS_MODULE=directory_backend.settings.development
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_LOCAL_ONLY
DATABASE_URL=postgresql://directory:directory@localhost:5432/directory
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
ACCESS_TOKEN_SIGNING_KEY=CHANGE_ME_LOCAL_ONLY
REFRESH_HMAC_SECRET=CHANGE_ME_LOCAL_ONLY
RECOVERY_HMAC_SECRET=CHANGE_ME_LOCAL_ONLY
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME_LOCAL_ONLY
S3_SECRET_ACCESS_KEY=CHANGE_ME_LOCAL_ONLY
S3_PUBLIC_BUCKET=directory-public
S3_PRIVATE_BUCKET=directory-private
OTP_PROVIDER=development
PUSH_PROVIDER=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
