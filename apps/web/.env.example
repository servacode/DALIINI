NEXT_PUBLIC_ROOT_DOMAIN=ROOT_DOMAIN
# Server-only origin of the Django API; read by server components for public
# directory pages. Unset/placeholder => pages render an "unavailable" state.
# Also read at build time: its origin is added to the CSP (next.config.ts).
PUBLIC_API_ORIGIN=https://api.ROOT_DOMAIN
# Server-only. The same value as the API's WEB_SERVER_API_KEY: sent as the
# X-Daliini-Web-Key header on every server-side API read, so the API counts the
# site's reads under its own limit instead of one shared address. Grants no data
# or permission. Never give it a NEXT_PUBLIC_ name: it must not reach the browser.
# Empty sends no header.
WEB_SERVER_API_KEY=
# The API origin as a visitor's browser reaches it, for the contact form, which
# posts from the browser so the API limits each sender, not the whole site.
# Build time: inlined into the page bundle and added to the CSP's connect-src.
# The API must list this site's origin (https://ROOT_DOMAIN) in its
# CORS_ALLOWED_ORIGINS. Empty => /contact shows the support email instead.
NEXT_PUBLIC_API_ORIGIN=https://api.ROOT_DOMAIN
SUPPORT_EMAIL=SUPPORT_EMAIL
PRIVACY_CONTACT_EMAIL=PRIVACY_CONTACT_EMAIL
# Optional store listings for the download CTA; leave empty to hide a button.
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Optional Android app (build time). With the package set, facility pages show
# «افتح في التطبيق»: an intent for the page's own https URL (an App Link) that
# falls back to the page itself when the app is not installed.
NEXT_PUBLIC_ANDROID_PACKAGE=
# SHA-256 fingerprints of the app's signing certificates, comma-separated
# (AA:BB:…:FF; the Play App Signing key, plus the upload key for directly
# installed builds). With the package above they publish
# /.well-known/assetlinks.json, which verifies the app's App Links for this
# domain; while either is empty that URL answers 404. Read at request time.
ANDROID_CERT_SHA256=
# Where the bar's "download the app" button points: a direct build now, the Play Store
# once the app is listed. Falls back to NEXT_PUBLIC_PLAY_STORE_URL; unset hides the button.
NEXT_PUBLIC_APP_DOWNLOAD_URL=
# Where slide and facility photographs are served from, when that is not the API's own
# origin (object storage usually is not). Build time: added to the CSP's img-src, and
# without it the browser blocks every one of those images.
NEXT_PUBLIC_MEDIA_ORIGIN=
# The base map's MapLibre style, the same one the app draws (DECISION-071). Unset, the site shows
# no map and nothing else changes. Build time: inlined, and its origin added to the CSP.
NEXT_PUBLIC_MAP_STYLE_URL=
# Other hosts the style's tiles, glyphs and sprites come from, comma-separated origins
# (https://tiles.example). Build time: added to the CSP's connect-src and img-src.
NEXT_PUBLIC_MAP_ORIGINS=
