<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The splash background: token semantic.surface.default. The system splash and the app's
         splash (BrandColors.splashBackground) both use it, so one hands over to the other without
         a change of colour; SplashThemeTest holds them together. -->
    <color name="brand_splash_background">@color/token_semantic_surface_default</color>
    <!-- The launcher icon's field, behind the mark: token colors.primarySoft. A launcher
         puts the icon on a wallpaper of any colour, so the icon carries its own background
         rather than borrowing the wallpaper's. scripts/build-brand-assets.py paints the same
         token into the icons older launchers draw whole. -->
    <color name="brand_launcher_background">@color/token_colors_primary_soft</color>
</resources>
