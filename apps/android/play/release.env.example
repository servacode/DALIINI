# Never commit real values.
DIRECTORY_API_BASE_URL=https://api.<ROOT_DOMAIN>/
DIRECTORY_REALTIME_WS_URL=wss://api.<ROOT_DOMAIN>/ws/events/
DIRECTORY_MAP_STYLE_URL=https://<APPROVED_MAP_STYLE_HOST>/style.json
DIRECTORY_ROUTING_BASE_URL=https://<APPROVED_ROUTING_HOST>/
DIRECTORY_GEOCODING_BASE_URL=https://<APPROVED_GEOCODING_HOST>/
DIRECTORY_GEOCODING_USER_AGENT=<FINAL_APP_USER_AGENT>
# The site's host for App Links (play/app-links.md); it must publish assetlinks.json.
DIRECTORY_APP_LINK_HOST=<ROOT_DOMAIN>
# Push (Firebase > Project settings > Your apps > the Android app). Push stays off when empty.
# The backend's FCM_PROJECT_ID must name the same project.
DIRECTORY_FIREBASE_PROJECT_ID=<FIREBASE_PROJECT_ID>
DIRECTORY_FIREBASE_APPLICATION_ID=<FIREBASE_ANDROID_APP_ID>
DIRECTORY_FIREBASE_API_KEY=<FIREBASE_WEB_API_KEY>
DIRECTORY_FIREBASE_SENDER_ID=<FIREBASE_SENDER_ID>
# Optional. Crash reporting stays off (no Sentry initialisation at all) when empty.
DIRECTORY_SENTRY_DSN=
ANDROID_UPLOAD_KEYSTORE_PATH=<ABSOLUTE_PATH_OUTSIDE_REPO>
ANDROID_UPLOAD_KEY_ALIAS=<UPLOAD_KEY_ALIAS>
ANDROID_UPLOAD_STORE_PASSWORD=<SECRET_IN_ENV_ONLY>
ANDROID_UPLOAD_KEY_PASSWORD=<SECRET_IN_ENV_ONLY>
