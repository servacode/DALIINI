<?xml version="1.0" encoding="utf-8"?>
<!-- The manifest cannot read a Kotlin constant, so the name exists twice: here for the launcher
     and in DirectoryBrand.NAME for everything the app draws. BrandNameTest fails if the two ever
     disagree, which is how the name came to be written five ways before. -->
<resources>
    <string name="app_name">دليني</string>

    <!-- What a notification is filed under in the phone's settings, and what it says when the
         message carried no words of its own. -->
    <string name="app_notification_channel">التحديثات</string>
    <string name="app_navigation_channel">الملاحة</string>
    <string name="app_navigation_title">الملاحة جارية</string>
    <string name="app_navigation_remaining">تبقّى %1$s، نحو %2$s</string>
    <string name="app_navigation_rerouting">يُعاد حساب الطريق…</string>
    <plurals name="app_navigation_minutes">
        <item quantity="zero">أقل من دقيقة</item>
        <item quantity="one">دقيقة</item>
        <item quantity="two">دقيقتين</item>
        <item quantity="few">%d دقائق</item>
        <item quantity="many">%d دقيقة</item>
        <item quantity="other">%d دقيقة</item>
    </plurals>
    <string name="app_update_available_title">يتوفر إصدار أحدث من دليني</string>
    <string name="app_update_available_body">هذه النسخة ما زالت تعمل، والأحدث فيها تحسينات وإصلاحات.</string>
    <string name="app_update_available_action">تحديث</string>
    <string name="app_update_available_later">لاحقاً</string>
    <string name="app_notification_body">لديك تحديث جديد</string>

    <!-- The home-screen widget: its name in the launcher's list, what the list says about it,
         and its own words. Offline and distances are the design system's shared words. -->
    <string name="widget_duty_label">المناوب الآن</string>
    <string name="widget_duty_description">أقرب المنشآت المناوبة الآن في محافظتك، والاتصال بها بلمسة.</string>
    <string name="widget_duty_title">المناوب الآن</string>
    <string name="widget_duty_no_province">افتح التطبيق واختر محافظتك لعرض المناوب الآن.</string>
    <string name="widget_duty_loading">جارٍ التحميل…</string>
    <string name="widget_duty_empty">لا توجد منشأة مناوبة الآن.</string>
    <!-- %1$s is a time on Damascus clocks, "14:30". -->
    <string name="widget_duty_updated">آخر تحديث %1$s</string>
    <!-- The call button, as a screen reader says it. %1$s is the facility's name. -->
    <string name="widget_duty_call">اتصال بـ%1$s</string>
</resources>
