# Where Django is reachable from the Admin server process. Server-side only; the browser
# never calls this origin, and the CSP would block it if a page tried.
ADMIN_API_ORIGIN=https://api.ROOT_DOMAIN

# The origin operators actually open. Session cookie attributes are derived from it:
# https anywhere means Secure cookies with the __Host- prefix, http is accepted only on
# loopback for local development, and http on any other host is refused at startup.
ADMIN_PUBLIC_ORIGIN=https://admin.ROOT_DOMAIN

NEXT_PUBLIC_APP_NAME=Directory Admin
NEXT_PUBLIC_ROOT_DOMAIN=ROOT_DOMAIN
