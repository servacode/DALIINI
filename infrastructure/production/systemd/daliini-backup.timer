[Unit]
Description=Daliini: hourly database backup, at 17 minutes past

[Timer]
# Every hour, so at most an hour of changes can be lost (RPO <= 1 hour, DECISION-081).
OnCalendar=*-*-* *:17:00 UTC
# A server that was off takes the backup when it comes back.
Persistent=true
RandomizedDelaySec=2m

[Install]
WantedBy=timers.target
