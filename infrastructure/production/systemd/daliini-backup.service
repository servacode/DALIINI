# The hourly database backup (DECISION-081). Installed by infrastructure/production/README.md.
[Unit]
Description=Daliini: dump the database to the backup bucket
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/srv/daliini/repo/infrastructure/production
ExecStart=/usr/bin/docker compose --env-file /srv/daliini/production.env run --rm backup
