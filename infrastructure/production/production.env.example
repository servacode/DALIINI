# The server's settings (DECISION-080). Copy to /srv/daliini/production.env, owned by the deploy
# user (deploy.sh writes RELEASE into it), mode 600, and fill in every <...>. Never commit the
# filled copy.
#
# Long random values: `openssl rand -base64 48` for each line marked (random).

# --- The deployment --------------------------------------------------------------------------
ENVIRONMENT=production
# Every `docker compose --env-file` command, the backup timer and deploy.sh act on this project.
# Staging's file says daliini-staging.
COMPOSE_PROJECT_NAME=daliini
# The domain the four names hang off: <ROOT>, www.<ROOT>, api.<ROOT>, admin.<ROOT>.
ROOT_DOMAIN=<ROOT_DOMAIN>
# Where Let's Encrypt writes about expiring certificates.
ACME_EMAIL=<OPS_EMAIL>
# Empty: build the images on this server. ghcr.io/servacode/: pull the ones CI published.
IMAGE_REGISTRY=
# The image tag this deploy builds or pulls. Published images are tagged <environment>-<commit>.
RELEASE=<GIT_SHA>
WEB_CONCURRENCY=2

# --- Secrets shared by the API, worker and beat (random) ------------------------------------
SECRET_KEY=<random>
ACCESS_TOKEN_SIGNING_KEY=<random>
REFRESH_HMAC_SECRET=<random>
RECOVERY_HMAC_SECRET=<random>
# At least 32 characters each.
PUSH_TOKEN_ENCRYPTION_KEY=<random>
MFA_ENCRYPTION_KEY=<random>
ANALYTICS_HASH_SALT=<random>
# Between the site's server and the API.
WEB_SERVER_API_KEY=<random>

# --- The database (on this server) ----------------------------------------------------------
POSTGRES_DB=daliini
POSTGRES_USER=daliini
POSTGRES_PASSWORD=<random>

# --- Media storage (an S3 service elsewhere) --------------------------------------------------
S3_ENDPOINT_URL=https://<ACCOUNT>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=<MEDIA_KEY_ID>
S3_SECRET_ACCESS_KEY=<MEDIA_SECRET>
S3_PUBLIC_BUCKET=<PUBLIC_BUCKET>
S3_PRIVATE_BUCKET=<PRIVATE_BUCKET>
# Where a browser fetches public photographs, with the bucket path if the provider needs one.
S3_PUBLIC_MEDIA_BASE_URL=https://media.<ROOT_DOMAIN>
# The same origin without a path: the site's and the console's image policy allow it.
MEDIA_ORIGIN=https://media.<ROOT_DOMAIN>

# --- Backups (a different bucket, and a key that can reach only it) --------------------------
BACKUP_S3_ENDPOINT_URL=https://<ACCOUNT>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=<BACKUP_BUCKET>
BACKUP_S3_PREFIX=daliini/postgres
BACKUP_S3_ACCESS_KEY_ID=<BACKUP_KEY_ID>
BACKUP_S3_SECRET_ACCESS_KEY=<BACKUP_SECRET>
BACKUP_RETENTION_DAYS=30

# --- Sign-in codes ----------------------------------------------------------------------------
# whatsapp_bot (the paired number on this server) or whatsapp (Meta's Cloud API).
OTP_PROVIDER=whatsapp_bot
WHATSAPP_BOT_TOKEN=<random>
# Only for whatsapp:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=ar

# --- Push (NOTIFICATIONS-SETUP.md) ------------------------------------------------------------
PUSH_PROVIDER=fcm
FCM_PROJECT_ID=<FIREBASE_PROJECT_ID>
# The service account key, as JSON or its base64.
FCM_SERVICE_ACCOUNT_JSON=<BASE64_KEY>

# --- The site ---------------------------------------------------------------------------------
SUPPORT_EMAIL=<SUPPORT_EMAIL>
PRIVACY_CONTACT_EMAIL=<PRIVACY_EMAIL>
PLAY_STORE_URL=
APP_STORE_URL=
APP_DOWNLOAD_URL=
# The release signing key's SHA-256, for App Links (apps/android/play/app-links.md).
ANDROID_CERT_SHA256=

# --- The base map and routing (DECISION-082) ----------------------------------------------------
# map/build-map.sh writes the map here and points current/ at the newest build.
MAP_DIR=/srv/daliini/map
# The style the site and the console draw, served by Martin under maps.<ROOT>. Its tiles, glyphs
# and icons come from the same origin, so MAP_ORIGINS stays empty.
MAP_STYLE_URL=https://maps.<ROOT_DOMAIN>/style/daliini
MAP_ORIGINS=

# --- Optional ---------------------------------------------------------------------------------
SENTRY_DSN=
