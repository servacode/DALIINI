# Directory Platform V3 — staging placeholders only. Never commit real values.
ENVIRONMENT=staging
DJANGO_SETTINGS_MODULE=directory_backend.settings.staging
SECRET_KEY=CHANGE_ME_STAGING_SECRET
ACCESS_TOKEN_SIGNING_KEY=CHANGE_ME_STAGING_32_CHARS_MIN
REFRESH_HMAC_SECRET=CHANGE_ME_STAGING_32_CHARS_MIN
RECOVERY_HMAC_SECRET=CHANGE_ME_STAGING_32_CHARS_MIN
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB
REDIS_URL=redis://HOST:6379/0
ALLOWED_HOSTS=directory-v3-staging-api.onrender.com
CORS_ALLOWED_ORIGINS=https://directory-v3-staging-www.onrender.com,https://directory-v3-staging-admin.onrender.com
CSRF_TRUSTED_ORIGINS=https://directory-v3-staging-admin.onrender.com
S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_BUCKET=directory-v3-staging-public
S3_PRIVATE_BUCKET=directory-v3-staging-private
OTP_PROVIDER=CHANGE_ME_NON_TEST_PROVIDER
PUSH_PROVIDER=fcm
PUSH_TOKEN_ENCRYPTION_KEY=CHANGE_ME_STAGING_32_CHARS_MIN
ANALYTICS_HASH_SALT=CHANGE_ME_STAGING_32_CHARS_MIN
FCM_PROJECT_ID=CHANGE_ME
# The Firebase service account key JSON (or its base64); required with PUSH_PROVIDER=fcm.
FCM_SERVICE_ACCOUNT_JSON=CHANGE_ME
SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
ROOT_DOMAIN=ROOT_DOMAIN
