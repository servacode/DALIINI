# Secrets / environment
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Node
node_modules/
.next/
coverage/

# Android / Gradle
.gradle/
**/build/
apps/android/jvm-verification/.kotlin/
local.properties
*.jks
*.keystore

# iOS / Xcode
DerivedData/
*.xcuserstate
xcuserdata/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime artifacts
artifacts/evidence/**/*.log
artifacts/evidence/**/*.xml
artifacts/evidence/**/*.html
artifacts/evidence/**/*.json
!artifacts/evidence/.gitkeep

# Local storage / DB
*.sqlite3
.minio/

# TypeScript incremental build state
*.tsbuildinfo

# Playwright browser binaries, pinned per app so a shared cache cannot prune them
apps/admin/.playwright-browsers/
apps/admin/test-results/
apps/admin/playwright-report/
apps/admin/.e2e-admin.log

# Playwright sessions created by global setup
apps/admin/tests/e2e/.auth/

# scripts/local-stack.sh: generated photo, logs
.local-stack/

# What a session leaves behind. The evidence under artifacts/ is the record and is committed;
# the builds it was taken from, and the bundles and checksums a handover is packed into, are
# not — they are reproducible from a run id and a tag.
artifacts/apk/
artifacts/apk-new/
artifacts/device-qa/
artifacts/handoff/

# A zip of this repository is not part of this repository. Git already stores every file and
# every version of it; a 33 MB copy would be carried by every clone for ever and be stale the
# moment anything changed. If one is wanted on GitHub, it belongs on a release, not in history.
DALINI-SOURCE.zip
*-SOURCE.zip

# What the assistant accumulated on this machine: an allowlist full of absolute paths from one
# session's scratchpad. It means nothing on another machine and grants permissions nobody asked
# for, so it stays local.
.claude/

# scripts/verify.sh regenerates the schema here to compare it; never committed.
.verify-schema.yaml

# Playwright writes failure traces and screenshots here; they are evidence of one run.
apps/web/test-results/
apps/admin/test-results/
